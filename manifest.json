{
  "manifest_version": 3,
  "name": "GHUX - GitHub UX",
  "version": "0.2.0",
  "description": "GitHub review experience improvements: word wrap in diffs, with more features to come.",
  "permissions": ["storage"],
  "host_permissions": ["https://github.com/*"],
  "action": {
    "default_title": "GHUX",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "css": ["features/word-wrap/wrap.css", "features/split-view/split.css"],
      "js": ["content.js", "features/split-view/split.js"],
      "run_at": "document_start"
    }
  ]
}
